# Copy this file to .env and set a real password. Never commit .env.
DB_NAME=ats
DB_USER=ats
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_PORT=3306

# Use a random value of at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change_me

# Initial ADMIN, created on startup if the email does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin
ADMIN_NAME=Administrator

# Directory for uploaded files (resumes). A relative path resolves from where the backend runs.
UPLOADS_DIR=./uploads

# Demo data (dev profile only): password of recruiter@demo.test, 8 characters or more and at most
# 72 bytes. Leave empty to skip that user.
DEMO_RECRUITER_PASSWORD=
